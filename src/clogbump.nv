// clogbump.nv — the next version, and the rule below 1.0 that changes
// the answer.
//
// Every body here is a `todo()`; the signatures are the design.
//
// THE DERIVATION.  Over a range of commits: any breaking change is a
// MAJOR bump, any `feat` is a MINOR bump, any `fix` is a PATCH bump,
// and nothing at all is no bump.  The largest wins.
//
// AND THEN THE 0.x RULE CHANGES IT.  Below 1.0.0 a breaking change is a
// MINOR bump and everything else is a PATCH — `0.x` is where a package
// says it is still finding its shape, and a project that let
// Conventional Commits drive `major` would have gone to 1.0.0 on its
// third week.  That is `docs/registry/semver.md`'s rule and this
// project's own practice.
//
// SO `next_version` TAKES THE CURRENT VERSION, not just the commits.
// A function that answered a `ClogBump` from commits alone would be
// answering half the question, and the half it left out is the half
// that differs between every pre-1.0 package on a registry and every
// post-1.0 one.  `bump_of` is the commit half on its own, published
// because a caller reporting "these commits contain a breaking change"
// wants it without a version in hand.
//
// WHAT THIS CANNOT SEE, AND THE README SAYS SO.  `docs/publishing.md`
// § Choosing the version: the test for "breaking" is whether a program
// that used the old version compiles and behaves correctly against the
// new one, unchanged — and raising the toolchain a package needs is a
// break by that test with every signature identical.  No commit message
// says so.  `bump_at_least` is how a caller that knows something this
// module cannot raises the answer.

use clogconv
use semver

// How far a version moves.
pub enum ClogBump
    // Nothing in the range changes anything a consumer can see.
    ClogNoBump
    ClogPatch
    ClogMinor
    ClogMajor

// What the commits alone say, before the pre-1.0 rule is applied.
//
// `ClogMajor` for any breaking change, `ClogMinor` for any `feat`,
// `ClogPatch` for any `fix`, `ClogNoBump` otherwise.  A type the map
// hides still counts for nothing; a type the map maps still counts as
// a patch, because a change a reader is told about is a change.
//
// ```novo
// use clogbump
// use clogconv
//
// fn main() [io]
//     let cs = [clogconv.parse_subject("feat: a new thing")]
//     println("${clogbump.bump_of(cs, clogconv.default_map()) == ClogMinor}")
// ```
pub fn bump_of(commits: [clogconv.ClogCommit], m: clogconv.ClogMap) -> ClogBump []
    todo("changelog-nv.clogbump.bump_of")

// The bump one commit implies.
pub fn bump_of_commit(c: clogconv.ClogCommit, m: clogconv.ClogMap) -> ClogBump []
    todo("changelog-nv.clogbump.bump_of_commit")

// The next version, under the pre-1.0 rule.
//
// THE CALL THIS MODULE EXISTS FOR, and the reason it takes `current`
// rather than only the commits: below 1.0.0 a `ClogMajor` becomes a
// minor bump and a `ClogMinor` becomes a patch.  A caller that derived
// a bump and applied it itself would get a pre-1.0 package wrong every
// time it broke something.
//
// A prerelease or build suffix on `current` is dropped: the next
// version of `1.2.3-rc.1` is `1.2.3` for a patch and `1.3.0` for a
// minor, which is what every release tool does and what the ordering
// rules require.
//
// ```novo
// use clogbump
// use clogconv
// use semver
//
// fn main() [io]
//     match semver.parse("0.4.2")
//         None    => println("not a version")
//         Some(v) =>
//             let cs = [clogconv.parse_subject("feat!: the old flag is gone")]
//             let next = clogbump.next_version(v, cs, clogconv.default_map())
//             println("${next.major}.${next.minor}.${next.patch}")
// ```
pub fn next_version(current: semver.Version, commits: [clogconv.ClogCommit],
                    m: clogconv.ClogMap) -> semver.Version []
    todo("changelog-nv.clogbump.next_version")

// The next version from a bump the caller already has.
//
// The same pre-1.0 rule, for a caller that decided the bump itself —
// a release script honouring a `--minor` flag, or one that knows about
// a break no commit message mentions.
pub fn apply_bump(current: semver.Version, b: ClogBump) -> semver.Version []
    todo("changelog-nv.clogbump.apply_bump")

// The larger of two bumps.
//
// `ClogMajor` over `ClogMinor` over `ClogPatch` over `ClogNoBump`.
// How a caller raises a derived answer with something this module
// cannot see — a raised toolchain floor, a dependency's break — which
// `docs/publishing.md` § Choosing the version names as a break with
// every signature identical.
pub fn bump_at_least(a: ClogBump, b: ClogBump) -> ClogBump []
    todo("changelog-nv.clogbump.bump_at_least")

// A bump's name: `none`, `patch`, `minor`, `major`.
pub fn bump_name(b: ClogBump) -> Str []
    todo("changelog-nv.clogbump.bump_name")

// A bump from its name, or `None`.
pub fn bump_from_name(s: Str) -> ?ClogBump []
    todo("changelog-nv.clogbump.bump_from_name")

// Whether a version is below 1.0.0, and therefore under the rule that
// changes the answer.
//
// Published because a tool explaining its own derivation to a person
// has to be able to say which rule it applied.
pub fn is_pre_1_0(v: semver.Version) -> Bool []
    todo("changelog-nv.clogbump.is_pre_1_0")

// The commits in a range that force a break.
//
// What a release note's "why is this a major" line is built from, and
// what a person reviewing a derived version reads before accepting it.
pub fn breaking_commits(commits: [clogconv.ClogCommit]) -> [clogconv.ClogCommit] []
    todo("changelog-nv.clogbump.breaking_commits")

// Whether a version follows another under the publish rules: greater,
// and not skipping a number a reader would expect.
//
// `1.2.3` after `1.2.2` is fine; `1.2.5` after `1.2.2` is greater and
// skips two patches, which is legal and is worth a caller knowing
// before it publishes a number nobody can find the release for.
// `novo pkg publish`'s own MONOTONIC refusal is the first half of this;
// the skip is the half that has no refusal and wants one.
pub fn follows(previous: semver.Version, next: semver.Version) -> Bool []
    todo("changelog-nv.clogbump.follows")
