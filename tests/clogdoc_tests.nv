// clogdoc_tests.nv — the publish, and the type that makes it one call.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: changelog-nv.<module>.<fn>`.
// That is the expected result until the bodies land.
//
// THE ASSERTION THIS SUITE EXISTS FOR: `promote` turns the Unreleased
// section into a dated release and leaves every other byte of the file
// alone. Everything else here is a consequence of Unreleased being a
// release with no version.
//
// THE VECTORS are `keep-a-changelog`'s own `spec/` fixtures, plus this
// repository's `docs/releases.md` shape, which is the same discipline
// in a different file.

use std.test
use std.list
use std.str
use semver
use civil
use mdparse
use clogdoc
use clogerr

fn sample() -> Str
    let lines = ["# Changelog",
                 "",
                 "All notable changes to this project are documented here.",
                 "",
                 "## [Unreleased]",
                 "",
                 "### Added",
                 "",
                 "- a thing with `code` in it",
                 "- a thing with a [link](https://example.invalid/)",
                 "",
                 "### Fixed",
                 "",
                 "- another thing",
                 "",
                 "## [1.2.0] - 2026-08-01",
                 "",
                 "### Added",
                 "",
                 "- the previous thing",
                 "",
                 "## [1.1.0] - 2026-07-01 [YANKED]",
                 "",
                 "### Removed",
                 "",
                 "- something that should not have gone",
                 "",
                 "[Unreleased]: https://example.invalid/compare/v1.2.0...HEAD",
                 "[1.2.0]: https://example.invalid/compare/v1.1.0...v1.2.0",
                 ""]
    list.join(lines, "\n")

fn v(text: Str) -> semver.Version
    semver.parse(text) ?? Version { major: 0, minor: 0, patch: 0, pre: "", build: "" }

@test
fn test_unreleased_is_a_release_with_no_version() [io]
    let d = clogdoc.parse(sample())!

    test.case("the document has three sections, and one of them is Unreleased")
    test.assert(list.len(d.releases) == 3)

    match clogdoc.unreleased(d)
        None    => test.assert(false)
        Some(u) =>
            test.case("THE CLAIM: it is a ClogRelease, and its version is None")
            test.assert(clogdoc.is_unreleased(u))
            test.assert(u.version == None)
            test.assert(u.date == None)

            test.case("with sections and entries, exactly like a released one")
            test.assert(list.len(u.sections) == 2)
            test.assert(clogdoc.entry_count(u) == 3)
            test.assert(not clogdoc.is_empty(u))

    test.case("and a released section is the same type with the fields filled in")
    match clogdoc.release_of(d, v("1.2.0"))
        None    => test.assert(false)
        Some(r) =>
            test.assert(not clogdoc.is_unreleased(r))
            test.assert(r.date != None)
            test.assert(not r.yanked)

@test
fn test_promote_is_the_publish() [io]
    let d = clogdoc.parse(sample())!
    let when = civil.date(2026, 9, 11)!
    let d2 = clogdoc.promote(d, v("1.3.0"), when)!

    test.case("the version is now a release")
    match clogdoc.release_of(d2, v("1.3.0"))
        None    => test.assert(false)
        Some(r) =>
            test.assert(clogdoc.entry_count(r) == 3)
            test.assert(r.date == Some(when))

    test.case("a fresh empty Unreleased section is open above it")
    match clogdoc.unreleased(d2)
        None    => test.assert(false)
        Some(u) => test.assert(clogdoc.is_empty(u))

    test.case("the older releases did not move")
    test.assert(list.len(d2.releases) == 4)
    test.assert(clogdoc.latest_version(d2) == Some(v("1.3.0")))

    test.case("and the link definition for the new version was written")
    test.assert(clogdoc.link_of(d2, "1.3.0") != None)

    test.case("set_link is the same call, for a forge that spells a compare URL its own way")
    let d3 = clogdoc.set_link(d2, "1.3.0", "https://example.invalid/releases/v1.3.0")
    match clogdoc.link_of(d3, "1.3.0")
        None    => test.assert(false)
        Some(l) => test.assert(str.contains(l.url, "releases/v1.3.0"))

@test
fn test_promote_refuses_the_two_things_it_exists_to_refuse() [io]
    test.case("a document with no Unreleased section has nothing to promote")
    let none_pending = clogdoc.parse("# Changelog\n\n## [1.0.0] - 2026-01-01\n\n### Added\n\n- a thing\n")!
    match clogdoc.promote(none_pending, v("1.1.0"), civil.date(2026, 9, 11)!)
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(not clogerr.is_parse_error(e))

    test.case("AND AN EMPTY UNRELEASED SECTION IS A RELEASE NOBODY WROTE NOTES FOR")
    let empty_pending = clogdoc.parse("# Changelog\n\n## [Unreleased]\n\n## [1.0.0] - 2026-01-01\n\n### Added\n\n- a thing\n")!
    match clogdoc.promote(empty_pending, v("1.1.0"), civil.date(2026, 9, 11)!)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a version that is not newer is refused here rather than by the registry")
    let d = clogdoc.parse(sample())!
    match clogdoc.promote(d, v("1.0.0"), civil.date(2026, 9, 11)!)
        Ok(_)  => test.assert(false)
        Err(e) =>
            test.assert(str.contains(clogerr.render(e, "CHANGELOG.md"), "CHANGELOG.md"))

            test.case("an edit refusal refers to no place in the document")
            test.assert(clogerr.error_at(e) == -1)

@test
fn test_an_entry_is_the_authors_own_bytes() [io]
    let d = clogdoc.parse(sample())!

    match clogdoc.unreleased(d)
        None    => test.assert(false)
        Some(u) =>
            let texts = clogdoc.entry_texts(d, u)

            test.case("three entries, in document order")
            test.assert(list.len(texts) == 3)

            test.case("an inline code span survived, because nothing read inside it")
            test.assert(texts[0] == "a thing with `code` in it")

            test.case("and so did a link")
            test.assert(str.contains(texts[1], "[link](https://example.invalid/)"))

            test.case("the entry is a RANGE, and the range reads back as the text")
            match clogdoc.section_of(u, ClogAdded)
                None    => test.assert(false)
                Some(s) => test.assert(clogdoc.entry_text(d, s.entries[0]) == texts[0])

@test
fn test_the_six_kinds_are_closed() [io]
    test.case("each of the six reads back from its own heading")
    test.assert(clogdoc.kind_from_name("Added") == Some(ClogAdded))
    test.assert(clogdoc.kind_from_name("Security") == Some(ClogSecurity))

    test.case("case-insensitively, because a heading is prose")
    test.assert(clogdoc.kind_from_name("fixed") == Some(ClogFixed))

    test.case("AND A SEVENTH IS NOT A KIND — it is a clogcheck finding")
    test.assert(clogdoc.kind_from_name("Performance") == None)
    test.assert(clogdoc.kind_from_name("Fixes") == None)

    test.case("the names are the standard's own spelling")
    test.assert(clogdoc.kind_name(ClogDeprecated) == "Deprecated")

    test.case("and the standard's order is a list, because every caller wants it in order")
    let ks = clogdoc.kinds()
    test.assert(list.len(ks) == 6)
    test.assert(ks[0] == ClogAdded)
    test.assert(clogdoc.kind_order(ClogAdded) == 0)
    test.assert(clogdoc.kind_order(ClogSecurity) == 5)

@test
fn test_a_yanked_release_is_marked_and_a_consumer_can_see_it() [io]
    let d = clogdoc.parse(sample())!

    match clogdoc.release_of(d, v("1.1.0"))
        None    => test.assert(false)
        Some(r) => test.assert(r.yanked)

    test.case("and the one above it is not")
    match clogdoc.release_of(d, v("1.2.0"))
        None    => test.assert(false)
        Some(r) => test.assert(not r.yanked)

@test
fn test_the_document_keeps_its_title_preamble_and_links() [io]
    let d = clogdoc.parse(sample())!

    test.case("the title")
    test.assert(clogdoc.title(d) == "Changelog")

    test.case("the paragraph under it")
    test.assert(str.contains(clogdoc.preamble(d), "All notable changes"))

    test.case("and the link definitions at the foot")
    test.assert(list.len(d.links) == 2)
    match clogdoc.link_of(d, "Unreleased")
        None    => test.assert(false)
        Some(l) => test.assert(str.contains(l.url, "compare"))

    test.case("a label nothing defines answers None")
    test.assert(clogdoc.link_of(d, "9.9.9") == None)

@test
fn test_the_versions_come_back_in_the_documents_own_order() [io]
    let d = clogdoc.parse(sample())!

    test.case("newest first, as the standard requires and as this file writes them")
    let vs = clogdoc.versions(d)
    test.assert(list.len(vs) == 2)
    test.assert(semver.compare(vs[0], vs[1]) > 0)

    test.case("and the latest is the first")
    test.assert(clogdoc.latest_version(d) == Some(v("1.2.0")))

    test.case("a document with nothing released has no latest version")
    let pending = clogdoc.parse("# Changelog\n\n## [Unreleased]\n")!
    test.assert(clogdoc.latest_version(pending) == None)

@test
fn test_a_release_can_be_sliced_out_verbatim() [io]
    let d = clogdoc.parse(sample())!

    match clogdoc.release_of(d, v("1.2.0"))
        None    => test.assert(false)
        Some(r) =>
            test.case("heading and all, exactly as it stands in the file")
            let text = clogdoc.release_text(d, r)
            test.assert(str.contains(text, "## [1.2.0] - 2026-08-01"))
            test.assert(str.contains(text, "- the previous thing"))

            test.case("and not one byte of the release below it")
            test.assert(not str.contains(text, "1.1.0"))

@test
fn test_add_entry_opens_the_section_in_the_standards_order() [io]
    let d = clogdoc.parse("# Changelog\n\n## [Unreleased]\n\n### Fixed\n\n- a fix\n")!
    let d2 = clogdoc.add_entry(d, ClogAdded, "a feature")!

    match clogdoc.unreleased(d2)
        None    => test.assert(false)
        Some(u) =>
            test.case("both sections are there")
            test.assert(list.len(u.sections) == 2)

            test.case("and Added comes before Fixed, which is the standard's order")
            test.assert(u.sections[0].kind == ClogAdded)
            test.assert(u.sections[1].kind == ClogFixed)

    test.case("an empty entry is refused rather than written")
    match clogdoc.add_entry(d, ClogAdded, "   ")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_byte_offset_becomes_a_position_only_when_somebody_asks() [io]
    let d = clogdoc.parse(sample())!

    test.case("the first byte is line 1, column 1")
    let p = clogdoc.position_of(d, 0)
    test.assert(p.0 == 1)
    test.assert(p.1 == 1)

    test.case("and the Unreleased heading is on line 5")
    match clogdoc.unreleased(d)
        None    => test.assert(false)
        Some(u) => test.assert(clogdoc.position_of(d, u.heading_start).0 == 5)

@test
fn test_an_empty_document_is_the_scaffold_every_changelog_opens_with() [io]
    let e = clogdoc.empty_doc()

    test.case("a title and a preamble, and no releases yet")
    test.assert(clogdoc.title(e) == "Changelog")
    test.assert(clogdoc.preamble(e) != "")
    test.assert(list.len(e.releases) <= 1)

@test
fn test_the_markdown_walk_is_markdown_nvs_and_its_options_are_the_callers() [io]
    test.case("the default parse is the commonmark one")
    match clogdoc.parse_with(sample(), mdparse.commonmark_options())
        Err(_) => test.assert(false)
        Ok(d)  => test.assert(list.len(d.releases) == 3)

    test.case("and the bound the default uses is published")
    test.assert(clogerr.default_depth() > 0)
